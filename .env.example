# ==============================================
# LibraHub — Environment Variables
# ==============================================
# Copy this file to server/.env for development
# In production, set these in your hosting platform (Render, etc.)

# ---- Database ----
# Development: use local PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/library_db
# Production (Neon): postgresql://user:pass@host/dbname?sslmode=require

# ---- JWT Secrets (MUST be unique and random in production) ----
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Client URL (for CORS) ----
# Development: Vite dev server
CLIENT_URL=http://localhost:5173
# Production: your Vercel URL, e.g. https://librahub.vercel.app

# ---- File Uploads ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
